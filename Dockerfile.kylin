# 银河麒麟系统专用Dockerfile
# 针对银河麒麟V10系统优化的Docker镜像构建文件
# 支持x86_64和ARM64架构

# 多阶段构建 - 构建阶段
FROM --platform=$BUILDPLATFORM golang:1.23.4-alpine AS builder

# 设置构建参数
ARG TARGETPLATFORM
ARG BUILDPLATFORM
ARG TARGETOS
ARG TARGETARCH

# 设置工作目录
WORKDIR /app

# 设置Go环境变量
ENV GO111MODULE=on \
    GOPROXY=https://goproxy.cn,direct \
    CGO_ENABLED=0

# 安装构建依赖
RUN apk --no-cache add \
    git \
    ca-certificates \
    tzdata \
    upx

# 复制依赖文件
COPY go.mod go.sum ./

# 下载依赖
RUN go mod download && go mod verify

# 复制源代码
COPY . .

# 构建应用 - 针对银河麒麟系统优化
RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -a -installsuffix cgo \
    -ldflags '-w -s -extldflags "-static"' \
    -o andorralee ./cmd/main.go

# 压缩二进制文件以减小镜像大小
RUN upx --best --lzma andorralee

# 运行时镜像 - 基于CentOS 8 Stream (与银河麒麟兼容性更好)
FROM centos:8

# 设置镜像标签
LABEL maintainer="andorralee-team" \
      version="1.0" \
      description="Andorralee蜜罐管理系统 - 银河麒麟专用版" \
      architecture="multi-arch"

# 配置CentOS 8 Stream源 (银河麒麟基于CentOS)
RUN sed -i 's/mirrorlist/#mirrorlist/g' /etc/yum.repos.d/CentOS-* && \
    sed -i 's|#baseurl=http://mirror.centos.org|baseurl=http://vault.centos.org|g' /etc/yum.repos.d/CentOS-* && \
    yum clean all && \
    yum makecache

# 安装运行时依赖
RUN yum update -y && \
    yum install -y \
        ca-certificates \
        tzdata \
        curl \
        wget \
        bash \
        procps \
        net-tools \
        iproute \
        iputils \
        && yum clean all \
        && rm -rf /var/cache/yum

# 设置时区
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && \
    echo $TZ > /etc/timezone

# 创建应用用户和组
RUN groupadd -r appgroup && \
    useradd -r -g appgroup -d /app -s /sbin/nologin appuser

# 创建工作目录
WORKDIR /app

# 从构建阶段复制二进制文件
COPY --from=builder /app/andorralee /app/
RUN chmod +x /app/andorralee

# 复制静态资源和脚本
COPY --from=builder /app/static /app/static
COPY --from=builder /app/scripts /app/scripts

# 创建必要的目录
RUN mkdir -p \
    /app/dm_home \
    /app/logs \
    /app/data \
    /app/config \
    /var/log/andorralee \
    && chown -R appuser:appgroup /app \
    && chown -R appuser:appgroup /var/log/andorralee

# 设置环境变量 - 银河麒麟系统优化
ENV MYSQL_HOST=mysql \
    MYSQL_PORT=3306 \
    MYSQL_USER=root \
    MYSQL_PASSWORD=123456 \
    MYSQL_DATABASE=andorralee \
    DAMENG_HOST=dameng \
    DAMENG_PORT=5236 \
    DAMENG_USER=SYSDBA \
    DAMENG_PASSWORD=Dm123456 \
    DAMENG_DATABASE=DOCKER_OPS \
    DM_HOME=/app/dm_home \
    GIN_MODE=release \
    GOOS=linux \
    LOG_LEVEL=info \
    LOG_PATH=/var/log/andorralee

# 暴露端口
EXPOSE 8081

# 添加健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8081/api/v1/health || exit 1

# 创建启动脚本
RUN echo '#!/bin/bash' > /app/start.sh && \
    echo 'set -e' >> /app/start.sh && \
    echo 'echo "启动Andorralee蜜罐管理系统..."' >> /app/start.sh && \
    echo 'echo "系统信息: $(uname -a)"' >> /app/start.sh && \
    echo 'echo "Go版本: $(go version 2>/dev/null || echo "Go未安装")"' >> /app/start.sh && \
    echo 'echo "当前用户: $(whoami)"' >> /app/start.sh && \
    echo 'echo "工作目录: $(pwd)"' >> /app/start.sh && \
    echo 'echo "环境变量检查:"' >> /app/start.sh && \
    echo 'echo "  MYSQL_HOST: $MYSQL_HOST"' >> /app/start.sh && \
    echo 'echo "  DAMENG_HOST: $DAMENG_HOST"' >> /app/start.sh && \
    echo 'echo "  DM_HOME: $DM_HOME"' >> /app/start.sh && \
    echo 'echo "启动应用..."' >> /app/start.sh && \
    echo 'exec /app/andorralee' >> /app/start.sh && \
    chmod +x /app/start.sh && \
    chown appuser:appgroup /app/start.sh

# 切换到非root用户
USER appuser

# 设置启动命令
CMD ["/app/start.sh"]
